# Shared image for the orchestrator and all scanners; apply changes with Kustomize.
KUBE_BENCH_IMAGE=docker.io/aquasec/kube-bench:v0.16.0

# Select the CIS benchmark from the bundled upstream mapping using the Kubernetes API version.
# Set an explicit value such as cis-1.12 to override automatic selection.
KUBE_BENCH_BENCHMARK=auto

# Cleanup delay after each scan Job finishes, in seconds (600 = 10 minutes; minimum 60).
# Cleanup removes the child Job and its Pod; collect reports from the orchestrator logs.
KUBE_BENCH_SCAN_TTL=600

# Deadline for each scan Job, in seconds (1800 = 30 minutes; must be positive).
KUBE_BENCH_SCAN_TIMEOUT=1800

# CPU requested for scheduling each scanner (50m = 0.05 CPU core).
KUBE_BENCH_CPU_REQUEST=50m

# Memory requested for scheduling each scanner (64Mi = 64 mebibytes).
KUBE_BENCH_MEMORY_REQUEST=64Mi

# CPU limit per scanner (500m = 0.5 CPU core).
KUBE_BENCH_CPU_LIMIT=500m

# Memory limit per scanner; exceeding it can cause the container to be OOM-killed.
KUBE_BENCH_MEMORY_LIMIT=256Mi
